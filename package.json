{
  "name": "ubuntu-service",
  "version": "1.2.1",
  "description": "Context-aware CLI to identify, inspect, restart, and view logs of the single systemd service running in the current directory on an Ubuntu VPS.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./v1": "./src/v1/index.js",
    "./v2": "./src/v2/index.js"
  },
  "bin": {
    "ubuntu-service": "bin/index.js",
    "us": "bin/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node bin/index.js",
    "cli": "node bin/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "ubuntu-service-detect": "file:../ubuntu-service-detect",
    "ubuntu-service-restart": "file:../ubuntu-service-restart"
  },
  "keywords": [
    "ubuntu",
    "systemd",
    "service",
    "vps",
    "process",
    "restart",
    "cwd",
    "caddy"
  ],
  "author": "KeshavSoft",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshavsoft/ubuntu-service.git"
  },
  "bugs": {
    "url": "https://github.com/keshavsoft/ubuntu-service/issues"
  },
  "homepage": "https://keshavsoft.github.io/ubuntu-service/",
  "engines": {
    "node": ">=18.0.0"
  }
}